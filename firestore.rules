// Group-only policy. This repository has no source-controlled rules for the
// other application collections, so this file must be merged into the
// deployed complete ruleset; it is not safe to deploy by itself.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function messagePath(groupId, messageId) {
      return /databases/$(database)/documents/groups/$(groupId)/messages/$(messageId);
    }

    function groupExists(groupId) {
      return exists(groupPath(groupId));
    }

    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && groupExists(groupId)
        && groupData(groupId).members.hasAny([request.auth.uid]);
    }

    function isOwner(groupId) {
      return signedIn() && groupExists(groupId)
        && groupData(groupId).ownerId == request.auth.uid;
    }

    function isAdmin(groupId) {
      return isOwner(groupId)
        || (isMember(groupId)
          && groupData(groupId).admins.hasAny([request.auth.uid]));
    }

    function isActiveGroup(groupId) {
      return groupExists(groupId)
        && (!groupData(groupId).keys().hasAny(['deleting'])
          || groupData(groupId).deleting != true);
    }

    function validUnreadKeys(data) {
      return !data.keys().hasAny(['unreadCounts'])
        || (data.unreadCounts is map
          && data.unreadCounts.keys().hasOnly(data.members));
    }

    function validNewGroup() {
      return request.resource.data.keys().hasOnly([
          'name', 'avatarUrl', 'ownerId', 'ownerName', 'admins', 'members',
          'memberCount', 'createdAt', 'unreadCounts'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'ownerId', 'ownerName', 'admins', 'members', 'memberCount',
          'createdAt', 'unreadCounts'
        ])
        && request.resource.data.name is string
        && request.resource.data.ownerName is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.memberCount == request.resource.data.members.size()
        && request.resource.data.createdAt == request.time
        && validUnreadKeys(request.resource.data)
        && (!request.resource.data.keys().hasAny(['avatarUrl'])
          || request.resource.data.avatarUrl == null
          || request.resource.data.avatarUrl is string);
    }

    function immutableGroupFields() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validMemberState() {
      return request.resource.data.members.hasAny([resource.data.ownerId])
        && request.resource.data.memberCount == request.resource.data.members.size()
        && request.resource.data.members.hasAll(request.resource.data.admins);
    }

    function onlyOwnUnreadChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['unreadCounts'])
        && request.resource.data.keys().hasAny(['unreadCounts'])
        && validUnreadKeys(request.resource.data)
        && (
          (!resource.data.keys().hasAny(['unreadCounts'])
            && request.resource.data.unreadCounts.keys()
              .hasOnly([request.auth.uid]))
          || (resource.data.keys().hasAny(['unreadCounts'])
            && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
              .affectedKeys().hasOnly([request.auth.uid]))
        );
    }

    function validLastMessage() {
      return request.resource.data.lastMessage is map
        && request.resource.data.lastMessage.keys().hasOnly([
          'messageId', 'text', 'imageUrl', 'voiceUrl', 'type', 'senderId',
          'senderName', 'createdAt'
        ])
        && request.resource.data.lastMessage.keys().hasAll([
          'messageId', 'text', 'type', 'senderId', 'senderName', 'createdAt'
        ])
        && request.resource.data.lastMessage.messageId is string
        && request.resource.data.lastMessage.text is string
        && request.resource.data.lastMessage.senderId == request.auth.uid
        && request.resource.data.lastMessage.senderName is string
        && request.resource.data.lastMessage.type in ['text', 'image', 'voice']
        && request.resource.data.lastMessage.createdAt == request.time
        && (request.resource.data.lastMessage.get('imageUrl', null) == null
          || request.resource.data.lastMessage.get('imageUrl', null) is string)
        && (request.resource.data.lastMessage.get('voiceUrl', null) == null
          || request.resource.data.lastMessage.get('voiceUrl', null) is string);
    }

    function validMessageSummaryUpdate(groupId) {
      let message = getAfter(messagePath(
        groupId, request.resource.data.lastMessage.messageId
      ));
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'unreadCounts'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['lastMessage'])
        && request.resource.data.keys().hasAny(['unreadCounts'])
        && validUnreadKeys(request.resource.data)
        && validLastMessage()
        && message.data.senderId == request.auth.uid
        && message.data.senderName == request.resource.data.lastMessage.senderName
        && message.data.text == request.resource.data.lastMessage.text
        && message.data.createdAt == request.time
        && message.data.get('imageUrl', null)
          == request.resource.data.lastMessage.get('imageUrl', null)
        && message.data.get('voiceUrl', null)
          == request.resource.data.lastMessage.get('voiceUrl', null);
    }

    function validAdminSettingsUpdate(groupId) {
      return isAdmin(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatarUrl'])
        && request.resource.data.name is string
        && (!request.resource.data.keys().hasAny(['avatarUrl'])
          || request.resource.data.avatarUrl == null
          || request.resource.data.avatarUrl is string);
    }

    function validMemberPresentationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['wallpaper', 'pinnedMessage'])
        && (!request.resource.data.keys().hasAny(['wallpaper'])
          || request.resource.data.wallpaper == null
          || (request.resource.data.wallpaper is map
            && request.resource.data.wallpaper.keys().hasOnly(['url', 'type'])
            && request.resource.data.wallpaper.keys().hasAll(['url', 'type'])
            && request.resource.data.wallpaper.url is string
            && request.resource.data.wallpaper.type == 'image'))
        && (!request.resource.data.keys().hasAny(['pinnedMessage'])
          || request.resource.data.pinnedMessage == null
          || (request.resource.data.pinnedMessage is map
            && request.resource.data.pinnedMessage.keys().hasOnly(['id', 'text'])
            && request.resource.data.pinnedMessage.keys().hasAll(['id', 'text'])
            && request.resource.data.pinnedMessage.id is string
            && request.resource.data.pinnedMessage.text is string));
    }

    function validAddMembers(groupId) {
      return isAdmin(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberCount'])
        && validMemberState()
        && request.resource.data.admins == resource.data.admins
        && request.resource.data.members.hasAll(resource.data.members);
    }

    function validAdminUpdate(groupId) {
      return isOwner(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['admins'])
        && validMemberState();
    }

    function validMemberRemoval(groupId) {
      let change = request.resource.data.memberChange;
      let memberId = change.memberId;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'admins', 'memberCount', 'unreadCounts', 'memberChange'])
        && change is map
        && change.keys().hasOnly(['memberId', 'action'])
        && change.keys().hasAll(['memberId', 'action'])
        && memberId is string
        && change.action == 'remove'
        && memberId != resource.data.ownerId
        && resource.data.members.hasAny([memberId])
        && request.resource.data.members
          == resource.data.members.removeAll([memberId])
        && request.resource.data.admins
          == resource.data.admins.removeAll([memberId])
        && request.resource.data.memberCount == request.resource.data.members.size()
        && (memberId == request.auth.uid || isOwner(groupId)
          || (isAdmin(groupId) && !resource.data.admins.hasAny([memberId])))
        && (
          (!resource.data.keys().hasAny(['unreadCounts'])
            && !request.resource.data.keys().hasAny(['unreadCounts']))
          || (resource.data.keys().hasAny(['unreadCounts'])
            && request.resource.data.keys().hasAny(['unreadCounts'])
            && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
              .affectedKeys().hasOnly([memberId])
            && validUnreadKeys(request.resource.data))
        );
    }

    function validDeletionMarker(groupId) {
      return isOwner(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deleting'])
        && request.resource.data.deleting is bool;
    }

    function validForwardedFrom() {
      return !('forwardedFrom' in request.resource.data)
        || (request.resource.data.forwardedFrom is map
          && request.resource.data.forwardedFrom.keys().hasOnly([
            'sourceType', 'sourceName', 'chatId', 'channelId', 'groupId',
            'messageId', 'postId', 'senderId', 'senderName'
          ])
          && request.resource.data.forwardedFrom.keys().hasAll([
            'sourceType', 'senderId'
          ])
          && request.resource.data.forwardedFrom.sourceType
            in ['chat', 'channel', 'group']
          && request.resource.data.forwardedFrom.senderId is string
          && (request.resource.data.forwardedFrom.get('sourceName', null) == null
            || request.resource.data.forwardedFrom.get('sourceName', null) is string)
          && (request.resource.data.forwardedFrom.get('senderName', null) == null
            || request.resource.data.forwardedFrom.get('senderName', null) is string)
          && (request.resource.data.forwardedFrom.get('chatId', null) == null
            || request.resource.data.forwardedFrom.get('chatId', null) is string)
          && (request.resource.data.forwardedFrom.get('channelId', null) == null
            || request.resource.data.forwardedFrom.get('channelId', null) is string)
          && (request.resource.data.forwardedFrom.get('groupId', null) == null
            || request.resource.data.forwardedFrom.get('groupId', null) is string)
          && (request.resource.data.forwardedFrom.get('messageId', null) == null
            || request.resource.data.forwardedFrom.get('messageId', null) is string)
          && (request.resource.data.forwardedFrom.get('postId', null) == null
            || request.resource.data.forwardedFrom.get('postId', null) is string));
    }

    function validNewMessage(groupId, messageId) {
      let afterGroup = getAfter(groupPath(groupId));
      return request.resource.data.keys().hasOnly([
          'text', 'imageUrl', 'voiceUrl', 'duration', 'waveform', 'senderId',
          'senderName', 'senderAvatarUrl', 'replyTo', 'createdAt', 'readBy',
          'reactions', 'forwardedFrom'
        ])
        && request.resource.data.keys().hasAll([
          'text', 'senderId', 'senderName', 'createdAt', 'readBy', 'reactions'
        ])
        && request.resource.data.text is string
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasOnly([request.auth.uid])
        && request.resource.data.reactions is map
        && validForwardedFrom()
        && afterGroup.data.lastMessage.messageId == messageId
        && afterGroup.data.lastMessage.senderId == request.auth.uid
        && afterGroup.data.lastMessage.senderName == request.resource.data.senderName
        && afterGroup.data.lastMessage.text == request.resource.data.text
        && afterGroup.data.lastMessage.createdAt == request.time
        && afterGroup.data.lastMessage.get('imageUrl', null)
          == request.resource.data.get('imageUrl', null)
        && afterGroup.data.lastMessage.get('voiceUrl', null)
          == request.resource.data.get('voiceUrl', null);
    }

    function validReadReceipt() {
      let before = resource.data.readBy;
      let after = request.resource.data.readBy;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readBy', 'lastReadBy'])
        && request.resource.data.lastReadBy == request.auth.uid
        && after.hasAll(before)
        && after.hasOnly(before.concat([request.auth.uid]))
        && (before.hasAny([request.auth.uid])
          ? after.size() == before.size()
          : after.size() == before.size() + 1);
    }

    function validReactionChange() {
      let change = request.resource.data.reactionChange;
      let token = change.token;
      let before = resource.data.reactions.get(token, []);
      let after = request.resource.data.reactions.get(token, []);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions', 'reactionChange'])
        && request.resource.data.reactionChange is map
        && change.keys().hasOnly(['token', 'uid', 'added'])
        && change.keys().hasAll(['token', 'uid', 'added'])
        && token is string
        && change.uid == request.auth.uid
        && change.added is bool
        && request.resource.data.reactions.diff(resource.data.reactions)
          .affectedKeys().hasOnly([token])
        && request.resource.data.reactions.diff(resource.data.reactions)
          .affectedKeys().hasAny([token])
        && (
          (change.added == true
            && !before.hasAny([request.auth.uid])
            && after.hasAll(before)
            && after.hasOnly(before.concat([request.auth.uid]))
            && after.size() == before.size() + 1)
          || (change.added == false
            && before.hasAny([request.auth.uid])
            && before.hasAll(after)
            && before.hasOnly(after.concat([request.auth.uid]))
            && before.size() == after.size() + 1)
        );
    }

    function validMessageUpdate(groupId) {
      return isActiveGroup(groupId)
        && (
          (request.auth.uid == resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'edited'])
            && request.resource.data.text is string
            && request.resource.data.edited == true)
          || (request.auth.uid == resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'imageUrl'])
            && request.resource.data.deleted == true
            && request.resource.data.text == '')
          || validReadReceipt()
          || validReactionChange()
        );
    }

    match /groups/{groupId} {
      allow create: if signedIn() && validNewGroup();
      allow get, list: if isMember(groupId);
      allow update: if isMember(groupId) && immutableGroupFields()
        && (onlyOwnUnreadChanged() || validMessageSummaryUpdate(groupId)
          || validAdminSettingsUpdate(groupId) || validMemberPresentationUpdate()
          || validAddMembers(groupId) || validAdminUpdate(groupId)
          || validMemberRemoval(groupId) || validDeletionMarker(groupId));
      allow delete: if isOwner(groupId) && resource.data.deleting == true;

      match /messages/{messageId} {
        allow get, list: if isMember(groupId);
        allow create: if isMember(groupId) && isActiveGroup(groupId)
          && validNewMessage(groupId, messageId);
        allow update: if isMember(groupId) && validMessageUpdate(groupId);
        allow delete: if isOwner(groupId) && groupData(groupId).deleting == true;
      }
    }
  }
}
